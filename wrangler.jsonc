{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seoservicesedmonton",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs first so it can redirect www to the bare domain and handle /api/contact.
    "run_worker_first": true
  },
  "vars": {
    "SUPABASE_URL": "https://nlxcidsyswgzsrtnrxyu.supabase.co",
    "LEAD_FROM": "Website Leads <leads@seoservicesedmonton.ca>"
  },
  "observability": { "enabled": true }
}
